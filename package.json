{
  "name": "retail-print-kit",
  "version": "0.2.1",
  "description": "Receipt printers, cash drawers and label printers for Node.js and Electron: ESC/POS (Epson and compatibles), Star, ZPL, TSPL, EZPL; USB, network and serial; templates, previews, a visual designer and a CLI.",
  "author": "Arkaprova Majumder <arka162@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/arka162/retail-print-kit.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./net": {
      "types": "./dist/transports/net.d.ts",
      "default": "./dist/transports/net.js"
    },
    "./usb": {
      "types": "./dist/transports/usb.d.ts",
      "default": "./dist/transports/usb.js"
    },
    "./serial": {
      "types": "./dist/transports/serial.d.ts",
      "default": "./dist/transports/serial.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser/retail-print-kit.mjs",
      "default": "./dist/browser/retail-print-kit.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "test": "npm run build && node --test test/run.js",
    "clean": "rm -rf dist",
    "build:browser": "esbuild src/browser.ts --bundle --format=iife --global-name=RetailPrintKit --platform=browser --external:zlib --outfile=dist/browser/retail-print-kit.js --minify --sourcemap && esbuild src/browser.ts --bundle --format=esm --platform=browser --external:zlib --outfile=dist/browser/retail-print-kit.mjs --minify",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@napi-rs/canvas": ">=0.1",
    "serialport": ">=10",
    "usb": ">=2"
  },
  "peerDependenciesMeta": {
    "serialport": {
      "optional": true
    },
    "usb": {
      "optional": true
    }
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@types/node": "^18.19.0",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.23.1",
    "serialport": "^12.0.0",
    "typescript": "^5.4.0",
    "usb": "^2.18.0"
  },
  "bin": {
    "retail-print-kit": "./bin/retail-print-kit.js"
  },
  "homepage": "https://arka162.github.io/retail-print-kit/",
  "bugs": {
    "url": "https://github.com/arka162/retail-print-kit/issues"
  },
  "keywords": [
    "escpos",
    "esc-pos",
    "esc/pos",
    "thermal-printer",
    "thermal",
    "receipt-printer",
    "receipt",
    "pos-printer",
    "pos",
    "point-of-sale",
    "retail",
    "cash-drawer",
    "cash drawer",
    "printer",
    "print",
    "epson",
    "tm-t88",
    "tm-t20",
    "tm-m30",
    "star-micronics",
    "star",
    "tsp100",
    "tsp143",
    "tsp650",
    "mc-print",
    "bixolon",
    "citizen",
    "xprinter",
    "rongta",
    "zebra",
    "zpl",
    "tspl",
    "tsc",
    "ezpl",
    "godex",
    "label-printer",
    "label",
    "barcode",
    "qrcode",
    "qr",
    "receipt-template",
    "receipt-designer",
    "usb",
    "serial",
    "network",
    "electron",
    "nodejs",
    "typescript"
  ]
}
